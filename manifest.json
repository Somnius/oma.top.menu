{
  "schemaVersion": 1,
  "id": "com.lefteros.somnius.oma-top-menu",
  "name": "Oma Top Menu",
  "version": "0.1.0",
  "author": "Lef",
  "license": "GPL-2.0-only",
  "description": "The focused app's menu (File, Edit, View...) on the left of the Omarchy top bar.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Oma Top Menu",
    "description": "Shows the focused window's menu in the bar. Place it in the left section for the menu, and again on the right or in the tray for an options icon.",
    "category": "Compositor",
    "allowMultiple": true,
    "defaultSection": "left",
    "defaults": {
      "dividers": false,
      "spacing": "normal",
      "showAppIcon": true,
      "hideGeneric": false
    },
    "schema": [
      {
        "key": "dividers",
        "type": "boolean",
        "label": "Dividers between menus",
        "defaultValue": false
      },
      {
        "key": "spacing",
        "type": "enum",
        "label": "Spacing",
        "options": [
          "compact",
          "normal",
          "roomy"
        ],
        "defaultValue": "normal"
      },
      {
        "key": "showAppIcon",
        "type": "boolean",
        "label": "Show the app icon",
        "defaultValue": true
      },
      {
        "key": "hideGeneric",
        "type": "boolean",
        "label": "Hide the generic menu for apps without a menu bar",
        "defaultValue": false
      }
    ]
  }
}
